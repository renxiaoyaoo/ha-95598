# Minimal placeholder config. Copy to .env and edit locally.

ACCOUNT="account@example.com"
PASSWORD="password1"

# Optional credential pool for accounts that can see the same bound user IDs.
# LOGIN_CREDENTIALS='[{"account":"account@example.com","password":"password1","label":"main"}]'

# Leave empty to only write SQLite and skip Home Assistant publishing.
MQTT_HOST="host.docker.internal"
MQTT_PORT=1883
# MQTT_USERNAME=""
# MQTT_PASSWORD=""

JOB_START_TIME="07:00"
JOB_TIMES=2
FETCH_ON_STARTUP=false
REPUBLISH_INTERVAL_MINUTES=0

DAILY_USAGE_WINDOW_DAYS=7
PUBLISH_TOU_DETAIL_SENSORS=false

# Use a private local tariff override when needed. Do not commit that file.
# TOU_PRICE_CONFIG=config/tou_price_config.local.json

LOGIN_FALLBACK=qrcode
CAPTCHA_POINT_CLICK_MAX_REFRESHES=4

NOTIFIER=none
# TG_BOT_TOKEN=""
# TG_CHAT_ID=""

HA_ENERGY_BACKFILL_ENABLED=false
# HA_RECORDER_DB_PATH=/ha-config/home-assistant_v2.db
