# Minimal placeholder config. Copy to .env and edit locally.

# Required: use either ACCOUNT/PASSWORD or LOGIN_CREDENTIALS.
ACCOUNT="account@example.com"
PASSWORD="password1"
# LOGIN_CREDENTIALS='[{"account":"account@example.com","password":"password1","label":"main"}]'

# Home Assistant MQTT. Leave MQTT_HOST empty to only write local SQLite.
MQTT_HOST="host.docker.internal"
MQTT_PORT=1883
MQTT_PUBLISH_TIMEOUT_SECONDS=10
# MQTT_USERNAME=""
# MQTT_PASSWORD=""

# Schedule.
JOB_START_TIME="07:00"
JOB_TIMES=2
FETCH_ON_STARTUP=false
REPUBLISH_INTERVAL_MINUTES=0
FETCH_ATTEMPT_TIMEOUT_MINUTES=30

# Fetch and publish size.
DAILY_USAGE_WINDOW_DAYS=7
HISTORY_GAP_ALERT_DAYS=30
PUBLISH_TOU_DETAIL_SENSORS=false

# Local tariff override. Do not commit private local tariff files.
# TOU_PRICE_CONFIG=config/tou_price_config.local.json

# Login fallback and captcha.
LOGIN_FALLBACK=qrcode
CAPTCHA_POINT_CLICK_MAX_REFRESHES=4
BROWSER_PROFILE_CACHE_MAX_MB=128
PAGE_TRACE_MODE=errors

# Notifications.
NOTIFIER=none
# TG_BOT_TOKEN=""
# TG_CHAT_ID=""

# Advanced: Home Assistant Energy recorder backfill.
HA_ENERGY_BACKFILL_ENABLED=false
# HA_RECORDER_DB_PATH=/ha-config/home-assistant_v2.db
# HA_ENERGY_BACKFILL_BACKUP_KEEP=2
